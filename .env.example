# 环境变量配置示例
# 复制此文件为 .env 并填写实际值

# ========== 模型存储配置 ==========

# 方案 1: 使用 Cloudflare R2（推荐用于生产环境）
# VITE_MODEL_BASE_URL=https://your-bucket.r2.dev

# 方案 2: 使用 CDN（如 Cloudflare CDN 对接 R2）
# VITE_MODEL_BASE_URL=https://cdn.yourdomain.com/models

# 方案 3: 本地开发（留空使用本地 /onnx-models/）
# VITE_MODEL_BASE_URL=

# ========== Cloudflare Pages 部署配置 ==========

# 在 Cloudflare Pages 设置中添加这些环境变量：
# MODEL_BASE_URL=https://your-bucket.r2.dev

# ========== Hugging Face Token（可选）==========
# 如果使用 Transformers.js 下载模型
# HF_TOKEN=your_token_here
